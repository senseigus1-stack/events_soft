[Unit]
Description=Vayobyzh production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vayobyzh
ExecStart=/opt/vayobyzh/deploy/ubuntu/up.sh
ExecStop=/opt/vayobyzh/deploy/ubuntu/down.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
