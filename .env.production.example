# Copy to .env and replace every value marked CHANGE_ME.
DOMAIN=events.example.com
SSL_EMAIL=admin@example.com

POSTGRES_DB=events
POSTGRES_USER=events
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
APP_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SYNC_API_KEY=CHANGE_ME_RANDOM_SYNC_SECRET
ADMIN_API_KEY=CHANGE_ME_RANDOM_ADMIN_SECRET

WEB_PORT=8080
PUBLIC_SITE_URL=https://events.example.com
CORS_ORIGINS=https://events.example.com
OAUTH_PUBLIC_BASE_URL=https://events.example.com
OAUTH_FRONTEND_URL=https://events.example.com

# Register the exact callback URL shown below in each provider dashboard:
# https://events.example.com/api/v1/auth/oauth/google/callback
# https://events.example.com/api/v1/auth/oauth/yandex/callback
# https://events.example.com/api/v1/auth/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

SYNC_CITY_SLUGS=msk,spb,ekb,kzn,nsk
SYNC_HORIZON_DAYS=120
SYNC_INTERVAL_MINUTES=360
NOTIFICATION_INTERVAL_SECONDS=60
TIMEPAD_ORGANIZATION_IDS=
TELEGRAM_TOKEN=
LOG_LEVEL=INFO
