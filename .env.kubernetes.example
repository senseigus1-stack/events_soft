# Copy to .env.kubernetes, replace every CHANGE_ME value and chmod 600.
# Use URL-safe hex secrets so DATABASE_URL needs no extra escaping.
DOMAIN=events.example.com
TLS_EMAIL=admin@example.com

POSTGRES_DB=events
POSTGRES_USER=events
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://events:CHANGE_ME_RANDOM_HEX_DATABASE_PASSWORD@postgres:5432/events

APP_SECRET=CHANGE_ME_RANDOM_HEX_APP_SECRET
SYNC_API_KEY=CHANGE_ME_RANDOM_HEX_SYNC_KEY
ADMIN_API_KEY=CHANGE_ME_RANDOM_HEX_ADMIN_KEY

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
TELEGRAM_TOKEN=
