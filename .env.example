POSTGRES_DB=events
POSTGRES_USER=events
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_SECRET=replace-with-at-least-32-random-characters
SYNC_API_KEY=replace-with-a-second-long-random-secret
ADMIN_API_KEY=replace-with-a-third-long-random-secret
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080

# KudaGo city slugs. Use `all` to import every city currently exposed by KudaGo.
SYNC_CITY_SLUGS=msk,spb,ekb,kzn,nsk
SYNC_HORIZON_DAYS=120
SYNC_INTERVAL_MINUTES=360
NOTIFICATION_INTERVAL_SECONDS=60

# Optional: public event feeds of selected Timepad organizations.
TIMEPAD_ORGANIZATION_IDS=

# Optional Telegram channel. Start with: docker compose --profile telegram up -d
TELEGRAM_TOKEN=
LOG_LEVEL=INFO
