POSTGRES_DB=events
POSTGRES_USER=events
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_SECRET=replace-with-at-least-32-random-characters
SYNC_API_KEY=replace-with-a-second-long-random-secret
ADMIN_API_KEY=replace-with-a-third-long-random-secret
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080
PUBLIC_SITE_URL=http://localhost:8080

# Public URLs used for OAuth callbacks. In production both normally equal https://DOMAIN.
OAUTH_PUBLIC_BASE_URL=http://localhost:8080
OAUTH_FRONTEND_URL=http://localhost:8080

# Create OAuth apps in the provider dashboards. Leave a pair empty to hide that provider.
# Callback URLs: https://YOUR_DOMAIN/api/v1/auth/oauth/{google|yandex|github}/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# KudaGo city slugs. Use `all` to import every city currently exposed by KudaGo.
SYNC_CITY_SLUGS=msk,spb,ekb,kzn,nsk
SYNC_HORIZON_DAYS=120
SYNC_INTERVAL_MINUTES=360
NOTIFICATION_INTERVAL_SECONDS=60

# Optional: public event feeds of selected Timepad organizations.
TIMEPAD_ORGANIZATION_IDS=

# Optional Telegram bot. deploy/ubuntu/up.sh starts it automatically when set.
TELEGRAM_TOKEN=
LOG_LEVEL=INFO
